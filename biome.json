{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/**/*.js",
      "apps/**/*.ts",
      "packages/**/*.js",
      "packages/**/*.ts",
      "package.json",
      "packages/**/package.json",
      "!**/dist",
      "!**/node_modules"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none"
    }
  },
  "assist": {
    "enabled": false
  }
}
