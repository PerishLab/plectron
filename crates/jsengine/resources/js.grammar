space = [\s]+;
line = '//' [^\n]*;
comment = '/*' (!'*/' .)* '*/';
quote = ['"];
hex = [0-9a-fA-F];
unicode = '{' hex+ '}' | hex hex hex hex;
name = [a-zA-Z_$] [a-zA-Z0-9_$]*;
number = [0-9]+ ('.' [0-9]*)?;
mark = '...' | '=>' | '&&=' | '||=' | '??=' | '+=' | '-=' | '*=' | '/=' | '%=' | '++' | '--' | '===' | '!==' | '<=' | '>=' | '&&' | '||' | [\[\]{}().,:;=+*/%!<>-];
